rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // Admin records must be provisioned manually or by a trusted server/Admin SDK.
      allow write: if false;
    }

    match /settings/social {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      // Guests/customers may place a COD order, but cannot read or modify orders.
      allow create: if request.resource.data.paymentMethod == 'COD'
        && request.resource.data.status == 'Placed'
        && request.resource.data.customerName is string
        && request.resource.data.phone is string
        && request.resource.data.address is string
        && request.resource.data.pincode is string;
      allow read, update, delete: if isAdmin();
    }
  }
}
